---
// One horizontal "shelf" of a playlist (E1 style): title, See all, YouTube, then a scrollable row of cards.
import VideoCard from './VideoCard.astro';
import Soon from './Soon.astro';
import { sectionItems, playlistUrl } from '../lib/data.mjs';
interface Props { s: any; max?: number }
const { s, max = 10 } = Astro.props;
const videos = sectionItems(s.level, s.section, 'video');
const shorts = sectionItems(s.level, s.section, 'short');
// Shelves show full videos only; Shorts live in the Shorts carousel.
const items = videos.slice(0, max);
const isShorts = false;
const yt = playlistUrl(s.level, s.section);
const count = videos.length;
---
<section class="shelf" data-lv={s.level} aria-labelledby={`shelf-${s.key}`}>
  <div class="shelf-head">
    <h3 id={`shelf-${s.key}`}><a href={s.path}>{s.sectionLabel}</a></h3>
    <div class="shelf-links">
      <a href={s.path} data-track="open-playlist-page">See all{count ? ` (${count})` : ''} ›</a>
      {yt && <a href={yt} target="_blank" rel="noopener noreferrer" data-track="open-playlist" aria-label={`${s.levelLabel} ${s.sectionLabel} playlist on YouTube`}>YouTube ↗</a>}
    </div>
  </div>
  {items.length
    ? <div class:list={['shelf-row', { 'is-shorts': isShorts }]} role="region" aria-label={`${s.levelLabel} ${s.sectionLabel}`} tabindex="0">
        {items.map((item) => <VideoCard item={item} context={{ level: s.level, section: s.section }} showLabels={false} />)}
      </div>
    : <Soon level={s.level} text={shorts.length ? "Full videos are coming soon. Watch the Shorts above!" : "New videos are coming soon."} />}
</section>
