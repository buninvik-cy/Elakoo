---
// Red "Subscribe" button that opens the YouTube channel.
// Uses a simple play icon. To use YouTube's official icon instead, put it at /public/brand/yt-icon.svg
// and set `official` below to true (YouTube's brand guidelines allow it for linking to a channel).
import { channelUrl } from '../lib/data.mjs';
interface Props { size?: 'sm' | 'lg'; label?: string }
const { size = 'lg', label = 'Subscribe on YouTube' } = Astro.props;
---
{channelUrl && (
  <a class:list={['btn-sub', `btn-sub-${size}`]} href={channelUrl} target="_blank" rel="noopener noreferrer" data-track="youtube-subscribe">
    <svg class="btn-sub-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    <span>{label}</span>
  </a>
)}
