---
// One playlist (section) of a level: watch on the site or open the playlist on YouTube.
// Without a YouTube playlist ID the card says "Coming soon" and has no links.
import { sectionSummary, playlistUrl } from '../lib/data.mjs';
interface Props { s: any }
const { s } = Astro.props;
const live = Boolean(s.playlistId);
const sum = live ? sectionSummary(s.level, s.section) : { videos: 0, shorts: 0, cover: null };
const yt = live ? playlistUrl(s.level, s.section) : null;
const parts = [];
if (sum.videos) parts.push(`${sum.videos} video${sum.videos === 1 ? '' : 's'}`);
if (sum.shorts) parts.push(`${sum.shorts} Short${sum.shorts === 1 ? '' : 's'}`);
const meta = live ? (parts.join(' · ') || 'New videos soon') : 'Coming soon';
---
<article class:list={['pl-card', { 'is-soon': !live }]}>
  {live ? (
    <a class="pl-cover" href={s.path} data-track="open-playlist-page" tabindex="-1" aria-hidden="true">
      {sum.cover ? <img src={sum.cover} alt="" loading="lazy" decoding="async" /> : <span class="pl-cover-text">{s.sectionLabel}</span>}
      <span class="pl-level">{s.levelLabel}</span>
    </a>
  ) : (
    <div class="pl-cover" aria-hidden="true"><span class="pl-cover-text">{s.sectionLabel}</span><span class="pl-level">{s.levelLabel}</span></div>
  )}
  <div class="pl-body">
    <h4 class="pl-title">{live ? <a href={s.path}>{s.sectionLabel}</a> : s.sectionLabel}</h4>
    <p class="pl-meta">{meta}</p>
    {live && (
      <div class="pl-actions">
        <a class="btn btn-primary btn-sm" href={s.path} data-track="open-playlist-page">Watch</a>
        {yt && <a class="btn btn-ghost btn-sm" href={yt} target="_blank" rel="noopener noreferrer" data-track="open-playlist" aria-label={`Open ${s.levelLabel} ${s.sectionLabel} playlist on YouTube`}>YouTube ↗</a>}
      </div>
    )}
  </div>
</article>
