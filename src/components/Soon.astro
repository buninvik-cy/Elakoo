---
// Friendly empty state: one of the channel's characters says the message.
import { levelGuide } from '../lib/sections.mjs';
interface Props { text: string; who?: 'maria' | 'nikos' | 'teacher'; level?: string }
const { text, level } = Astro.props;
const who = Astro.props.who || (level ? levelGuide(level) : 'maria');
---
<div class="soon">
  <img src={`/brand/chars/${who}-av.webp?v=3`} alt="" width="72" height="72" loading="lazy" decoding="async" />
  <p>{text}</p>
</div>
