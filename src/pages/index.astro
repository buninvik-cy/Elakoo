---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import ShortsRow from '../components/ShortsRow.astro';
import ContactForm from '../components/ContactForm.astro';
import { LEVELS, SECTIONS } from '../lib/sections.mjs';
import { latest, channelUrl } from '../lib/data.mjs';

const latestVideos = latest('video', 6);
const latestShorts = latest('short', 8);
---
<Base title="ELAKOO">
  <div class="container">
    <section class="hero">
      <p class="badge">LEARN GREEK WITH ELAKOO</p>
      <h1>Prepare for your Greek exam</h1>
      <p class="lead">Free A2 &amp; B1 Greek exam video practice. Watch here or on YouTube.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/videos/">Explore videos</a>
        {channelUrl && <a class="btn btn-ghost" href={channelUrl} target="_blank" rel="noopener noreferrer" data-track="youtube-channel">YouTube channel</a>}
      </div>
    </section>

    <section class="block" aria-labelledby="sections-h">
      <h2 id="sections-h">Choose an exam section</h2>
      <div class="levels">
        {LEVELS.map((lvl) => (
          <div class="level-col" id={lvl.slug}>
            <h3 class="level-head">{lvl.label}</h3>
            <ul class="section-list">
              {SECTIONS.filter((s) => s.level === lvl.slug).map((s) => (
                <li><a href={s.path} data-track="choose-section"><span>{s.sectionShort}</span><span aria-hidden="true">›</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="lv-h">
      <div class="block-head">
        <h2 id="lv-h">Latest Videos</h2>
        <a href="/videos/?format=video">All videos →</a>
      </div>
      {latestVideos.length
        ? <div class="grid-videos">{latestVideos.map((item) => <VideoCard item={item} />)}</div>
        : <p class="empty">New videos are coming soon.</p>}
    </section>

    <section class="block" aria-labelledby="ls-h">
      <div class="block-head">
        <h2 id="ls-h">Latest Shorts</h2>
        <a href="/videos/?format=short">All Shorts →</a>
      </div>
      {latestShorts.length
        ? <ShortsRow items={latestShorts} label="Latest Shorts" />
        : <p class="empty">Shorts are coming soon.</p>}
    </section>

    <div class="two-col block">
      <section class="panel" id="about" aria-labelledby="about-h">
        <h2 id="about-h">About Elakoo</h2>
        <p>Elakoo is a free collection of video practice for the Greek language exam at levels A2 and B1. Every video is organised by exam section, so you can quickly find practice for Speaking Parts 1–3 and Writing.</p>
        <p><a href="/about/">More about Elakoo →</a></p>
      </section>
      <section class="panel" id="contact" aria-labelledby="contact-h">
        <h2 id="contact-h">Contact</h2>
        <ContactForm compact />
      </section>
    </div>
  </div>
</Base>
