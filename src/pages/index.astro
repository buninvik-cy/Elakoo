---
import Base from '../layouts/Base.astro';
import ShortsRow from '../components/ShortsRow.astro';
import Shelf from '../components/Shelf.astro';
import Soon from '../components/Soon.astro';
import { LEVELS, GROUPS, ALL_SECTIONS } from '../lib/sections.mjs';
import { levelItems, channelUrl } from '../lib/data.mjs';

const levels = LEVELS.map((l) => {
  const sections = ALL_SECTIONS.filter((s) => s.level === l.slug);
  const live = sections.filter((s) => s.playlistId);
  // Live playlists in group order (exam first, then practice).
  const order = GROUPS.map((g) => g.slug);
  live.sort((a, b) => order.indexOf(a.group) - order.indexOf(b.group));
  return {
    ...l,
    live,
    soon: sections.filter((s) => !s.playlistId),
    shorts: levelItems(l.slug, 'short').slice(0, 16),
  };
});
const defaultLevel = (levels.find((l) => l.live.length) || levels[0])?.slug;
const levelList = LEVELS.map((l) => l.label).join(', ').replace(/, ([^,]*)$/, ' and $1');
---
<Base title="ELAKOO" description={`Free ${levelList} Greek exam video practice: speaking, writing, listening, stories and vocabulary. Watch here or on YouTube.`}>
  <section class="hero" id="levels" data-levels data-default={defaultLevel}>
    <div class="container hero-inner">
      <h1>Greek exam. <span class="hero-accent">Ready!</span></h1>
      <p class="lead">Free video practice for {levelList}. Watch here or on YouTube.</p>
      <div class="level-capsule" role="tablist" aria-label="Level">
        {levels.map((l) => (
          <a role="tab" class="level-tab" data-lv={l.slug} id={`tab-${l.slug}`} href={`/?level=${l.slug}#levels`} aria-controls={`panel-${l.slug}`} data-level-tab={l.slug} data-track="choose-level">{l.label}</a>
        ))}
      </div>
    </div>
    <div class="hero-chars" aria-hidden="true">
      <img class="char char-left" src="/brand/chars/teacher.webp" alt="" width="387" height="720" decoding="async" fetchpriority="low" />
      <img class="char char-right" src="/brand/chars/maria.webp" alt="" width="288" height="720" decoding="async" fetchpriority="low" />
      <img class="char char-phone" src="/brand/chars/nikos.webp" alt="" width="295" height="720" decoding="async" fetchpriority="low" />
    </div>
    <div class="skyline" aria-hidden="true"></div>
  </section>

  <div class="band">
    <div class="container">
      {levels.map((l) => (
        <div class="level-panel" data-lv={l.slug} id={`panel-${l.slug}`} role="tabpanel" aria-labelledby={`tab-${l.slug}`} data-level-panel={l.slug}>
          <h2 class="sr-only">Level {l.label}</h2>
          {!l.live.length && <Soon text={`${l.label} videos are coming soon. Meanwhile, try the other levels!`} />}

          {l.shorts.length > 0 && (
            <section class="shelf" aria-labelledby={`shorts-${l.slug}`}>
              <div class="shelf-head">
                <h3 id={`shorts-${l.slug}`}>Shorts <span class="muted">Quick practice</span></h3>
                <div class="shelf-links"><a href={`/videos/?format=short&level=${l.slug}`}>See all ›</a></div>
              </div>
              <ShortsRow items={l.shorts} context={{ level: l.slug }} label={`${l.label} Shorts`} showLabels={false} />
            </section>
          )}

          {l.live.map((s) => <Shelf s={s} />)}

          {l.live.length > 0 && l.soon.length > 0 && (
            <p class="soon-line"><span>Coming soon:</span> {l.soon.map((s) => s.sectionLabel).join(' · ')}</p>
          )}
        </div>
      ))}
    </div>
  </div>

  {channelUrl && (
    <section class="cta">
      <div class="container cta-inner">
        <h2>Don’t miss new videos.</h2>
        <a class="btn btn-primary" href={channelUrl} target="_blank" rel="noopener noreferrer" data-track="youtube-channel">Subscribe on YouTube</a>
      </div>
    </section>
  )}
</Base>
<script>
  const root = document.querySelector<HTMLElement>('[data-levels]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-level-tab]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-level-panel]')];
    const valid = new Set(tabs.map((t) => t.dataset.levelTab));
    const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
    const write = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* ignore */ } };

    function show(level: string) {
      tabs.forEach((t) => {
        const on = t.dataset.levelTab === level;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => (p.hidden = p.dataset.levelPanel !== level));
      window.dispatchEvent(new Event('resize'));
    }

    const fromUrl = new URLSearchParams(location.search).get('level');
    const start = [fromUrl, read('elakoo-level'), root.dataset.default].find((l) => l && valid.has(l)) || tabs[0]?.dataset.levelTab;
    if (start) show(start);

    tabs.forEach((t, i) => {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        const level = t.dataset.levelTab!;
        show(level);
        write('elakoo-level', level);
        const url = new URL(location.href); url.searchParams.set('level', level); url.hash = '';
        history.replaceState(null, '', url);
      });
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.click(); next.focus();
      });
    });
  }
</script>
