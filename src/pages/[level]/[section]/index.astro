---
import Base from '../../../layouts/Base.astro';
import VideoCard from '../../../components/VideoCard.astro';
import ShortsRow from '../../../components/ShortsRow.astro';
import Player from '../../../components/Player.astro';
import { SECTIONS, ALL_SECTIONS } from '../../../lib/sections.mjs';
import { sectionItems, playlistUrl } from '../../../lib/data.mjs';

export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { level: s.level, section: s.section }, props: { s } }));
}

const { s } = Astro.props;
const context = { level: s.level, section: s.section };
const videos = sectionItems(s.level, s.section, 'video');
const shorts = sectionItems(s.level, s.section, 'short');
const plUrl = playlistUrl(s.level, s.section);
const PAGE = 12;
const siblings = ALL_SECTIONS.filter((x) => x.level === s.level);
---
<Base title={`${s.levelLabel} · ${s.sectionLabel}`} description={`${s.description} Free Greek ${s.levelLabel} exam videos and Shorts.`}>
  <div class="container" data-lv={s.level}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href={`/?level=${s.level}#levels`}>{s.levelLabel}</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{s.sectionLabel}</span>
    </nav>
    <header class="page-head" data-lv={s.level}>
      <h1><span class="lv-badge">{s.levelLabel}</span> {s.sectionLabel}</h1>
      <p class="lead">{s.description}</p>
      {plUrl && <a class="btn btn-ghost" href={plUrl} target="_blank" rel="noopener noreferrer" data-track="open-playlist">Open playlist on YouTube ↗</a>}
    </header>

    <nav class="chips" data-lv={s.level} aria-label={`${s.levelLabel} sections`}>
      {siblings.map((x) => x.playlistId
        ? <a class:list={['chip', { on: x.key === s.key }]} href={x.path} aria-current={x.key === s.key ? 'page' : undefined}>{x.sectionLabel}</a>
        : <span class="chip soon" title="Coming soon">{x.sectionLabel}</span>)}
    </nav>
  </div>
  <div class="band" data-lv={s.level}>
  <div class="container band-stack">
    <Player items={[...videos, ...shorts]} context={context} />

    <section class="block" aria-labelledby="sh-h">
      <div class="shelf-head"><h2 id="sh-h">Shorts <span class="muted">Quick practice</span></h2></div>
      {shorts.length
        ? <ShortsRow items={shorts} context={context} expandable showLabels={false} label={`${s.levelLabel} ${s.sectionLabel} Shorts`} />
        : <p class="empty">Shorts are coming soon.</p>}
    </section>
    <section class="block" aria-labelledby="fv-h">
      <div class="shelf-head"><h2 id="fv-h">Full videos</h2></div>
      {videos.length ? (
        <div data-paged data-page-size={PAGE}>
          <div class="grid-videos">{videos.map((item) => <VideoCard item={item} context={context} showLabels={false} />)}</div>
          {videos.length > PAGE && <button type="button" class="btn btn-ghost load-more" data-load-more>Load more</button>}
        </div>
      ) : <p class="empty">New videos are coming soon.</p>}
    </section>
  </div>
  </div>
</Base>
<script>
  // Simple "Load more" for long grids: hide cards beyond the page size until requested.
  document.querySelectorAll<HTMLElement>('[data-paged]').forEach((box) => {
    const size = Number(box.dataset.pageSize) || 12;
    const cards = [...box.querySelectorAll<HTMLElement>('.card')];
    const btn = box.querySelector<HTMLButtonElement>('[data-load-more]');
    const selected = new URLSearchParams(location.search).get('v');
    let shown = size;
    const selIndex = cards.findIndex((c) => c.dataset.videoId === selected);
    if (selIndex >= shown) shown = Math.ceil((selIndex + 1) / size) * size;
    const render = () => {
      cards.forEach((c, i) => (c.hidden = i >= shown));
      if (btn) btn.hidden = shown >= cards.length;
    };
    btn?.addEventListener('click', () => { shown += size; render(); });
    render();
  });
</script>
