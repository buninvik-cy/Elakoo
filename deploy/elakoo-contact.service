[Unit]
Description=Elakoo contact form server
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/elakoo
EnvironmentFile=/etc/elakoo/contact.env
ExecStart=/usr/bin/node /opt/elakoo/server/contact-server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
