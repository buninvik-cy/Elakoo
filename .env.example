# Copy to .env for local sync tests. NEVER commit real keys.
# In production these live in GitHub Secrets (YOUTUBE_API_KEY)
# and in Cloudflare Pages -> Settings -> Variables and Secrets (the rest).

# YouTube Data API v3 key (Google Cloud Console). Restrict it to "YouTube Data API v3".
YOUTUBE_API_KEY=

# Contact form (Cloudflare Pages Function functions/api/contact.js)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Elakoo website <no-reply@elakoo.com>"
# Optional: Cloudflare Turnstile secret
TURNSTILE_SECRET_KEY=
