# Copy to .env for local sync tests. NEVER commit real keys.
# In production all of these live in GitHub Secrets; the deploy writes the form keys
# to /etc/elakoo/contact.env on the server.

# YouTube Data API v3 key (Google Cloud Console). Restrict it to "YouTube Data API v3".
YOUTUBE_API_KEY=

# Contact form (server/contact-server.mjs + functions/api/contact.js)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Elakoo website <no-reply@elakoo.com>"
# Optional: Cloudflare Turnstile secret
TURNSTILE_SECRET_KEY=
